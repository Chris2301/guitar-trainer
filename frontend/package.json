{
  "name": "guitar-trainer",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui-port=8080 --ui-host=0.0.0.0",
    "e2e:i18n": "playwright test --project=i18n",
    "extract-i18n": "ng extract-i18n",
    "serve:i18n": "node e2e/serve-i18n.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/animations": "^21.2.5",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/localize": "^21.2.5",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@ng-web-apis/common": "^4.14.0",
    "@ng-web-apis/mutation-observer": "^4.14.0",
    "@taiga-ui/cdk": "^4.75.0",
    "@taiga-ui/core": "^4.75.0",
    "@taiga-ui/event-plugins": "^4.7.0",
    "@taiga-ui/i18n": "^4.75.0",
    "@taiga-ui/polymorpheus": "^4.9.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.3",
    "@angular/cli": "^21.2.3",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
